# Copy to .env and add your Anthropic API key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional settings (real environment variables take precedence).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# FS_ASSISTANT_ROOT=
# Multi-workspace keys require a workspace ID; workspace-scoped keys do not.
# ANTHROPIC_WORKSPACE_ID=
